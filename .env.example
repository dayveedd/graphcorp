# ==============================================================================
# GraphCorp Environment Configuration
# ==============================================================================

# FalkorDB Database Configuration
# (Defaults to localhost:6379, or automatically uses zero-latency in-memory fallback engine if server is unreachable)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphcorp

# Google Gemini API Key (Optional)
# If omitted or offline, GraphCorp seamlessly activates deterministic zero-hallucination agent fallbacks
GEMINI_API_KEY=

# Web UI Dashboard Server Configuration
PORT=8000
HOST=0.0.0.0
